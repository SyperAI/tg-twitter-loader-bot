# -------------------------------------------------------------
# Telegram Bot Token (obtained from @BotFather)
# -------------------------------------------------------------
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# -------------------------------------------------------------
# Local Bot API Server Configuration (Optional)
# -------------------------------------------------------------
# Leave empty to use official Telegram Cloud API (https://api.telegram.org)
# BOT_API_URL=http://localhost:8081

# Set to 'true' if the Local Bot API server is running on the SAME server/machine.
# When true, files are passed directly via local filesystem paths (zero-copy).
# Set to 'false' if Local Bot API is running on a DIFFERENT server/container (uploaded via HTTP).
# Default: false
# BOT_API_IS_LOCAL=false

# -------------------------------------------------------------
# Custom Max Upload File Size Limit in MB (Optional)
# -------------------------------------------------------------
# Defaults:
# - 50 MB when using Telegram Cloud Bot API
# - 2000 MB when using Local Bot API Server
# CUSTOM_MAX_FILESIZE_MB=50
